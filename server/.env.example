PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSCHEMA=stage

# Servis katalog kaynağı: mock | inventory
# - mock      → varsayılan (kod fallback); mock katalog, offline geliştirme
# - inventory → inventory_db bağlantısı; F1/F2 geliştirme ve prod hedefi
# F2 checklist geçince .env.example varsayılanı inventory olacak; mock satırı silinmez, yorumda kalır.
CATALOG_SOURCE=mock

# Inventory katalog (env şeması) — DWH'den ayrı pool
# CATALOG_SOURCE=inventory iken zorunlu
INVENTORY_PGHOST=127.0.0.1
INVENTORY_PGPORT=5432
INVENTORY_PGDATABASE=inventory_db
INVENTORY_PGUSER=postgres
INVENTORY_PGPASSWORD=
INVENTORY_PGSCHEMA=env

# Süreç akışı (PAR → env.process.description_tr + process_definition)
# — inventory_db restore / env.process şema değişikliği sonrası MUTLAKA yeniden çalıştırın:
#   psql ... -f server/sql/process_par_migration.sql
#   cd server && PROCESS_PAR_ROOT=/path/to/par npm run ingest:process-par
# — Deploy / CI kontrolü: npm run verify:process-catalog (API ayaktayken)
# — SQL dosyasını silmek DB verisini silmez; veri kaybı genelde dump restore veya boş kolon + import atlanmasıdır.
# PROCESS_PAR_ROOT=/path/to/par
